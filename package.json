{
  "name": "omp-herdsman",
  "version": "0.1.0-herakles.0",
  "type": "module",
  "description": "Asynchronous OMP (oh-my-pi) subagents and agent fleet orchestration for parallel coding agents with nested delegation in herdr. Port of pi-herdsman.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yagizkaterli/omp-herdsman.git"
  },
  "bugs": {
    "url": "https://github.com/yagizkaterli/omp-herdsman/issues"
  },
  "homepage": "https://github.com/yagizkaterli/omp-herdsman#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "omp-extension",
    "subagent",
    "subagents",
    "agents",
    "ai-agents",
    "coding-agents",
    "coding-agent-orchestration",
    "multi-agent",
    "multi-agent-coding",
    "agent-fleet",
    "parallel-agents",
    "parallel-coding-agents",
    "background-agents",
    "nested-agents",
    "agent-orchestration",
    "orchestration",
    "delegation",
    "supervision",
    "herdr",
    "omp-herdsman",
    "omp",
    "oh-my-pi"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "."
    ]
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import=./scripts/test-env.mjs --test --test-timeout=10000",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "package:audit": "node scripts/package-audit.mjs",
    "validate": "npm run check && npm run build && npm run package:audit",
    "release:check": "npm run validate && npm publish --dry-run --ignore-scripts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.0.0",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0",
    "@oh-my-pi/pi-tui": ">=18.0.0",
    "@oh-my-pi/pi-utils": ">=18.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^18.4.2",
    "@oh-my-pi/pi-coding-agent": "^18.4.2",
    "@oh-my-pi/pi-tui": "^18.4.2",
    "@oh-my-pi/pi-utils": "^18.4.2",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "LICENSE",
    "docs",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "."
    ]
  },
  "ompHerdsman": {
    "runtime": {
      "omp": "18.4.2",
      "herdr": {
        "version": "0.9.1",
        "sha256": {
          "linux-x86_64": "2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7",
          "linux-aarch64": "f4ccf4de745f2cb9a39a983e9ba3703dad50ec2a58dea83026ceab721bbd8d9e",
          "macos-x86_64": "053be0639935fe54ab5efbdb46651054e4f6a753a5b43153c88bd6912bce1e94",
          "macos-aarch64": "5fc7a7e7adfaca56fa80aa89dcb025693357268dab8285b9ce2d08a2313c89de"
        }
      }
    }
  }
}
